[
 {
  "custom_format": 1,
  "disabled": 0,
  "doc_type": "Sales Invoice",
  "doctype": "Print Format",
  "html": "<div style=\"font-family: Helvetica, Arial, sans-serif; font-size: 12px; color: #111; line-height: 1.5;\">\n\t<div style=\"display: flex; justify-content: space-between; align-items: flex-start; border-bottom: 2px solid #111; padding-bottom: 12px; margin-bottom: 16px;\">\n\t\t<div>\n\t\t\t<h2 style=\"margin: 0;\">{{ doc.company }}</h2>\n\t\t\t<div style=\"color: #555;\">{{ doc.company_address_display or \"\" }}</div>\n\t\t</div>\n\t\t<div style=\"text-align: right;\">\n\t\t\t<h3 style=\"margin: 0;\">{{ doc.nrs_receipt_type or \"Invoice\" }}</h3>\n\t\t\t<div><strong>{{ doc.name }}</strong></div>\n\t\t\t<div>Date: {{ frappe.utils.format_date(doc.posting_date) }}</div>\n\t\t\t{% if doc.due_date %}<div>Due: {{ frappe.utils.format_date(doc.due_date) }}</div>{% endif %}\n\t\t</div>\n\t</div>\n\n\t<div style=\"margin-bottom: 16px;\">\n\t\t<div style=\"font-weight: bold; color: #555; text-transform: uppercase; font-size: 10px;\">Bill To</div>\n\t\t<div><strong>{{ doc.customer_name }}</strong></div>\n\t\t<div>{{ doc.address_display or \"\" }}</div>\n\t</div>\n\n\t<table style=\"width: 100%; border-collapse: collapse; margin-bottom: 16px;\">\n\t\t<thead>\n\t\t\t<tr style=\"border-bottom: 2px solid #111; text-align: left;\">\n\t\t\t\t<th style=\"padding: 6px 4px;\">#</th>\n\t\t\t\t<th style=\"padding: 6px 4px;\">Item</th>\n\t\t\t\t<th style=\"padding: 6px 4px; text-align: right;\">Qty</th>\n\t\t\t\t<th style=\"padding: 6px 4px; text-align: right;\">Rate</th>\n\t\t\t\t<th style=\"padding: 6px 4px; text-align: right;\">Amount</th>\n\t\t\t</tr>\n\t\t</thead>\n\t\t<tbody>\n\t\t\t{% for row in doc.items %}\n\t\t\t<tr style=\"border-bottom: 1px solid #ddd;\">\n\t\t\t\t<td style=\"padding: 6px 4px;\">{{ row.idx }}</td>\n\t\t\t\t<td style=\"padding: 6px 4px;\">{{ row.item_name }}</td>\n\t\t\t\t<td style=\"padding: 6px 4px; text-align: right;\">{{ row.qty }}</td>\n\t\t\t\t<td style=\"padding: 6px 4px; text-align: right;\">{{ frappe.utils.fmt_money(row.rate, currency=doc.currency) }}</td>\n\t\t\t\t<td style=\"padding: 6px 4px; text-align: right;\">{{ frappe.utils.fmt_money(row.net_amount, currency=doc.currency) }}</td>\n\t\t\t</tr>\n\t\t\t{% endfor %}\n\t\t</tbody>\n\t</table>\n\n\t<div style=\"display: flex; justify-content: flex-end; margin-bottom: 16px;\">\n\t\t<table style=\"border-collapse: collapse; min-width: 260px;\">\n\t\t\t<tr>\n\t\t\t\t<td style=\"padding: 4px;\">Net Total</td>\n\t\t\t\t<td style=\"padding: 4px; text-align: right;\">{{ frappe.utils.fmt_money(doc.net_total, currency=doc.currency) }}</td>\n\t\t\t</tr>\n\t\t\t<tr>\n\t\t\t\t<td style=\"padding: 4px;\">VAT</td>\n\t\t\t\t<td style=\"padding: 4px; text-align: right;\">{{ frappe.utils.fmt_money(doc.total_taxes_and_charges, currency=doc.currency) }}</td>\n\t\t\t</tr>\n\t\t\t<tr style=\"border-top: 2px solid #111; font-weight: bold;\">\n\t\t\t\t<td style=\"padding: 4px;\">Grand Total</td>\n\t\t\t\t<td style=\"padding: 4px; text-align: right;\">{{ frappe.utils.fmt_money(doc.grand_total, currency=doc.currency) }}</td>\n\t\t\t</tr>\n\t\t</table>\n\t</div>\n\n\t{% if doc.nrs_irn %}\n\t<div style=\"border: 1px solid #bbb; border-radius: 4px; padding: 12px; display: flex; gap: 16px; align-items: flex-start; page-break-inside: avoid;\">\n\t\t{% if doc.nrs_qr_image %}\n\t\t<img src=\"{{ doc.nrs_qr_image }}\" style=\"width: 110px; height: 110px;\">\n\t\t{% endif %}\n\t\t<div>\n\t\t\t<div style=\"font-weight: bold;\">NRS E-Invoice</div>\n\t\t\t<div style=\"font-size: 11px;\">IRN: {{ doc.nrs_irn }}</div>\n\t\t\t<div style=\"font-size: 11px;\">Status: {{ doc.nrs_receipt_status }}</div>\n\t\t\t{% if doc.nrs_time %}<div style=\"font-size: 11px;\">Transmitted: {{ frappe.utils.format_datetime(doc.nrs_time) }}</div>{% endif %}\n\t\t\t<div style=\"color: #666; font-size: 10px; margin-top: 6px;\">This invoice was transmitted to the Nigeria Revenue Service via the Doftwerks E-Invoice Access Point. Scan the QR code to verify.</div>\n\t\t</div>\n\t</div>\n\t{% endif %}\n</div>",
  "module": "Doftwerks NRS E-Invoicing",
  "name": "NRS E-Invoice",
  "print_format_type": "Jinja",
  "standard": "No"
 }
]
